# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# ИИ (RouterAI / OpenAI-совместимый API)
ROUTERAI_API_KEY=

# Telegram-бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_LINK_TOKEN=

# Yandex Object Storage + SpeechKit (аудио/видео)
YANDEX_BUCKET_NAME=
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_API_KEY=

# Google Calendar (опционально; файлы credentials — в data/)
GOOGLE_CALENDAR_EVENT_MINUTES=30

# Часовой пояс напоминаний
TELEGRAM_REMINDER_TZ=Europe/Moscow
