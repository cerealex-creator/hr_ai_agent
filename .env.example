# Скопируйте этот файл в .env и заполните значения:
# cp .env.example .env

# ИИ (RouterAI / OpenAI-совместимый API)
ROUTERAI_API_KEY=

# Telegram-бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_LINK_TOKEN=
# Кто может подтверждать встречи кнопкой в чате (username без @)
TELEGRAM_HR_CONFIRM_USERNAME=cerealeks
# Личный chat_id HR для утренних напоминаний о явке (узнать: @userinfobot)
TELEGRAM_HR_USER_ID=

# Yandex Object Storage + SpeechKit (аудио/видео)
YANDEX_BUCKET_NAME=
YANDEX_ACCESS_KEY_ID=
YANDEX_SECRET_ACCESS_KEY=
YANDEX_API_KEY=

# Google Calendar (опционально; файлы credentials — в data/)
GOOGLE_CALENDAR_EVENT_MINUTES=30

# Часовой пояс напоминаний
TELEGRAM_REMINDER_TZ=Europe/Moscow

# Только на VPS (Timeweb): принудительный IPv4 для aiogram, если IPv6 до Telegram недоступен
# TELEGRAM_FORCE_IPV4=1

# Если api.telegram.org недоступен с Mac (блокировка): socks5://127.0.0.1:1080 или http://…
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
