# === Timeweb pilot (.env.prod) ===
# Copy: cp .env.production.example .env.prod
# Then: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# See DEPLOY.md

PUBLIC_HOST=hr.example.com

POSTGRES_USER=hr_v2
POSTGRES_PASSWORD=replace-with-long-random-db-password
POSTGRES_DB=hr_v2

# Strong secret ≥32 chars (API refuses to start in production without it)
JWT_SECRET=replace-with-long-random-jwt-secret-at-least-32-chars
APP_ENV=production
AUTH_DISABLED=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=   # leave empty for same-origin host

# Owner seed (created on API boot if user missing)
AUTH_BOOTSTRAP_EMAIL=owner@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-owner-password-min-8
AUTH_BOOTSTRAP_ROLE=platform_owner

# Browser hits same origin; CORS allowlist = public HTTPS origin
CORS_ORIGINS=https://hr.example.com

# Pilot channels: Bitrix + web client zone. Telegram off on Timeweb (RKN).
MESSAGING_OUTBOUND_ENABLED=false
MESSAGING_INBOUND_ENABLED=false
MESSAGING_POLL_ENABLED=false

# Optional integrations (fill as needed)
# ROUTERAI_API_KEY=
# AI_BASE_URL=https://routerai.ru/api/v1
# AI_MODEL_NAME=qwen/qwen3.5-plus-20260420
# HH_ACCESS_TOKEN=
# HH_USER_AGENT=HR_AI_Agent_v2/1.0 (you@example.com)
# YANDEX_API_KEY=
# YANDEX_BUCKET_NAME=
# YANDEX_ACCESS_KEY_ID=
# YANDEX_SECRET_ACCESS_KEY=

HTTP_PORT=80
HTTPS_PORT=443
