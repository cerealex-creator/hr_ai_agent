# Sidecar on same VPS as LexForge (HTTP by IP until domain/TLS).
# Copy to .env.sidecar on the server — do not commit secrets.

PUBLIC_HOST=201.34.137.208
HTTP_PORT=8080

POSTGRES_USER=hr_v2
POSTGRES_PASSWORD=CHANGE_ME_DB
POSTGRES_DB=hr_v2

APP_ENV=pilot
JWT_SECRET=CHANGE_ME_JWT_AT_LEAST_32_CHARS_LONG_RANDOM
AUTH_DISABLED=false
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

AUTH_BOOTSTRAP_EMAIL=owner@hr.local
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_OWNER
AUTH_BOOTSTRAP_ROLE=platform_owner

# Same-origin via Next rewrite; allow IP origin for cookies/CORS edge cases
CORS_ORIGINS=http://201.34.137.208:8080

MESSAGING_OUTBOUND_ENABLED=false
MESSAGING_INBOUND_ENABLED=false
MESSAGING_POLL_ENABLED=false

# AI (RouterAI) — required for document generation
ROUTERAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=https://routerai.ru/api/v1
AI_MODEL_NAME=qwen/qwen3.5-plus-20260420

# HH.ru — токен менеджера работодателя (системный, для всех пользователей)
# Получить: cd v2/backend && .venv/bin/python scripts/hh_oauth.py
# или скопировать HH_* из корневого .env
# HH_CLIENT_ID=
# HH_CLIENT_SECRET=
# HH_ACCESS_TOKEN=
# HH_REFRESH_TOKEN=
# HH_USER_AGENT=HR_AI_Agent_v2/1.0 (you@example.com)

# Яндекс.Диск OAuth (скачивание резюме, inbox, папки вакансий)
# Токен: Настройки → Способы добавления → подключить Диск
# или скопировать data/yandex_disk_oauth.json / YANDEX_DISK_OAUTH_TOKEN из локального .env
# YANDEX_DISK_OAUTH_TOKEN=

# Яндекс SpeechKit + Object Storage (расшифровка записи собеседования)
# Скопировать из корневого .env Streamlit
# YANDEX_API_KEY=
# YANDEX_BUCKET_NAME=
# YANDEX_ACCESS_KEY_ID=
# YANDEX_SECRET_ACCESS_KEY=
# FFMPEG_BINARY=  # опционально; в образе обычно ffmpeg в PATH
