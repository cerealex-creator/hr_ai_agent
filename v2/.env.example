# v2 only — не путать с корневым .env Streamlit/бота
POSTGRES_USER=hr_v2
POSTGRES_PASSWORD=hr_v2_dev
POSTGRES_DB=hr_v2
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://hr_v2:hr_v2_dev@localhost:5433/hr_v2

# Путь к snapshot данных текущей версии (только чтение)
LEGACY_DATA_DIR=../data

REDIS_URL=redis://localhost:6380/0
REDIS_PORT=6380

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
# Public UI origin for customer share links (interview digest /i/… and client zone /c/…).
# PUBLIC_APP_URL=https://hr-toolbox.ru
# Experiment: short Telegram card (FIO + «Смотреть кандидата»). false = старый формат с кнопками статусов.
# TELEGRAM_CARD_MINIMAL=true
# D4: Next.js rewrite target (browser uses same-origin /api/v1/*).
# Local: http://localhost:8000 · Docker web→api: http://api:8000
# API_REWRITE_URL=http://localhost:8000
# API_INTERNAL_URL=http://localhost:8000

# Auth (D1) — JWT httpOnly cookies
# APP_ENV=local
# AUTH_DISABLED=false          # true only for local (ignored if APP_ENV=production)
# JWT_SECRET=change-me-long-random
# JWT_ACCESS_TTL_MINUTES=30
# JWT_REFRESH_TTL_DAYS=14
# AUTH_COOKIE_SECURE=false     # true behind HTTPS on Timeweb
# AUTH_COOKIE_SAMESITE=lax     # none + secure if API/UI on different sites
# AUTH_COOKIE_DOMAIN=
# AUTH_BOOTSTRAP_EMAIL=owner@example.com
# AUTH_BOOTSTRAP_PASSWORD=change-me-now
# AUTH_BOOTSTRAP_ROLE=platform_owner

# === Timeweb pilot (см. DEPLOY.md + .env.production.example) ===
# APP_ENV=production
# JWT_SECRET=…                 # ≥32 chars, иначе API не стартует
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# CORS_ORIGINS=https://your.domain
# MESSAGING_OUTBOUND_ENABLED=false
# MESSAGING_INBOUND_ENABLED=false
# MESSAGING_POLL_ENABLED=false
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# SpeechKit / Object Storage — те же ключи, что в корневом .env Streamlit
# (Settings также подхватывает ../../.env). Не коммитьте секреты.
# YANDEX_API_KEY=
# YANDEX_BUCKET_NAME=
# YANDEX_ACCESS_KEY_ID=
# YANDEX_SECRET_ACCESS_KEY=
# FFMPEG_BINARY=

# Yandex Disk OAuth (создание папок / inbox) — отдельно от SpeechKit
# YANDEX_DISK_OAUTH_TOKEN=
# YANDEX_DISK_OAUTH_TOKEN_PATH=
# YANDEX_DISK_CLIENT_ID=   # опционально; обычно задаётся в UI → app_settings.json

# Pilot channels: Bitrix + web client zone (app_settings client_notify). Telegram client outbound
# is gated by MESSAGING_OUTBOUND_ENABLED + bot token; HR DM only if TELEGRAM_HR_USER_ID set.
# TELEGRAM_BOT_TOKEN=   # Messaging Gateway (тот же токен, что у Streamlit — осторожно)
# MESSAGING_OUTBOUND_ENABLED=false  # false on Timeweb (RKN); true only if bot reachable
# MESSAGING_INBOUND_ENABLED=false  # true только без polling bot.py / на тестовом токене
# MESSAGING_POLL_ENABLED=false     # true → python -m app.workers.telegram_poller (getUpdates, без HTTPS)
# TELEGRAM_HR_USER_ID=             # numeric Telegram user id HR (attendance / −30/−10 / HR-confirm)
# TELEGRAM_REMINDER_TZ=Europe/Moscow
# MESSAGING_REMINDER_INTERVAL_SEC=60

# Google Calendar (пути по умолчанию — LEGACY_DATA_DIR)
# GOOGLE_CALENDAR_CREDENTIALS=../data/google_calendar_credentials.json
# GOOGLE_CALENDAR_TOKEN=../data/google_calendar_token.json
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_EVENT_MINUTES=30

# Zoom User OAuth (Marketplace → OAuth app; Client ID/Secret общие для деплоя)
# Токены access/refresh хранятся в organizations.integrations.zoom (per-org), не в файле.
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_REDIRECT_URI=http://localhost:8765/
# ZOOM_TOKEN_PATH=../data/zoom_oauth_token.json   # только для миграции со старого файла
# ZOOM_OAUTH_SCOPES=meeting:write user:read offline_access

# Шаблон оффера Word (.docx). Пусто = v2/backend/app/assets/offer_template.docx
# См. v2/backend/app/assets/OFFER_TEMPLATE.md
# OFFER_TEMPLATE_PATH=

# HH.ru — системный токен менеджера работодателя (вариант A)
# HH_ACCESS_TOKEN=
# HH_USER_AGENT=HR_AI_Agent_v2/1.0 (you@example.com)

# ИИ для оценки резюме из HH (как Streamlit)
# ROUTERAI_API_KEY=
# AI_BASE_URL=https://routerai.ru/api/v1
# AI_MODEL_NAME=qwen/qwen3.5-plus-20260420
